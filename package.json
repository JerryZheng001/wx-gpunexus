{
  "name": "suanlishi-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "算力市 · GPU 供需与行情微信小程序",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch --disable-global-config --no-check",
    "build:weapp": "taro build --type weapp --disable-global-config --no-check",
    "dev:h5": "taro build --type h5 --watch --disable-global-config --no-check",
    "build:h5": "taro build --type h5 --disable-global-config --no-check",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:config": "node scripts/check-config.cjs",
    "check:weapp": "node scripts/check-weapp.cjs",
    "check:api": "node --import tsx scripts/check-market-api.ts",
    "preview:h5": "node scripts/preview-server.cjs",
    "prebuild:weapp": "npm run check:config",
    "postbuild:weapp": "npm run check:weapp",
    "prebuild:h5": "npm run check:config"
  },
  "dependencies": {
    "@tarojs/components": "4.1.9",
    "@tarojs/helper": "4.1.9",
    "@tarojs/plugin-framework-react": "4.1.9",
    "@tarojs/plugin-platform-weapp": "4.1.9",
    "@tarojs/plugin-platform-h5": "4.1.9",
    "@tarojs/react": "4.1.9",
    "@tarojs/runtime": "4.1.9",
    "@tarojs/shared": "4.1.9",
    "@tarojs/taro": "4.1.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.12",
    "echarts": "5.6.0"
  },
  "devDependencies": {
    "@tarojs/cli": "4.1.9",
    "@tarojs/webpack5-runner": "4.1.9",
    "@babel/core": "^7.26.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "babel-preset-taro": "4.1.9",
    "sass": "^1.83.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "webpack": "5.91.0",
    "@babel/preset-react": "^7.24.1",
    "react-refresh": "^0.14.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11"
  },
  "overrides": {
    "schema-utils@^4": "4.3.3"
  }
}
